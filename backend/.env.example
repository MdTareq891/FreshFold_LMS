# === Database ===
# Free MongoDB Atlas connection string (see DEPLOYMENT.md for how to get one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/freshfold?retryWrites=true&w=majority

# === Auth ===
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-password

# === CORS ===
# Comma-separated list of allowed frontend origins (e.g. your Vercel/Netlify URL)
CORS_ORIGIN=http://localhost:5173

# === Email notifications (free Gmail SMTP) ===
# See DEPLOYMENT.md for how to create a Gmail "App Password"
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# === Web Push notifications (free, no third-party account) ===
# Generate with: npm run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@yourcompany.com

# === Server ===
PORT=4000
